{
  "manifest_version": 3,
  "name": "Delpix — Descargar imágenes en máxima resolución",
  "version": "1.0.0",
  "description": "Descarga cualquier imagen de la web en su máxima resolución con un solo clic.",
  "permissions": ["downloads", "contextMenus", "storage", "declarativeNetRequestWithHostAccess", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Delpix",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
